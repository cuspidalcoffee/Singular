LIB "presmatrix.lib";
LIB "homolog.lib";  // depth
LIB "modules.lib";



proc evf(ideal i, )
{
    int n = length(i);

    if (nvars(basering) + 1 != n)
        { ERROR("not a hypersurface"); }

    matrix m = jacob(i);

    poly mu = m[n, n-1] / m[n-1, n-1];
    vector qp = m[n, 1..n-1] - mu * m[n-1, 1..n-1];


}