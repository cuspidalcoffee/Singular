    LIB "presmatrix.lib";

    ring r = 0, (x, y), ds;
    ring rz = 0, (x, y, @z), ds;
    ring R = 0, (X, Y, Z), ds;

    // ----- Compute C{x,y}/(py,tau) -----

    setring rz;

    int n = 6;
    poly p = y3 - 3*x^n*y;
    poly q = y4 - 2*x^n*y2;

    poly @py = diff(p, y);

    poly @P = (p - subst(p, y, @z)) / (y - @z);
    poly @alpha = reduce(@P, @py) / (y - @z);
    
    poly @Q = (q - subst(q, y, @z)) / (y - @z);
    poly @beta = reduce(@Q, @py) / (y - @z);

    poly @tau = resultant(@P, @Q, @z) / @py^2;

    setring r;
    poly @tau = imap(rz, @tau);
    poly @py = imap(rz, @py);
    ideal @ii = @py, @tau;

    "";
    "<py, tau>:";
    @ii;

    "";
    "C{x,y}/<py, tau>:";
    kbase(std(@ii));

    // ----- Compute C{X,Y,Z}/F2(f) -----

    map f = R, x, imap(rz, p), imap(rz, q);
    ideal zero = 0;

    presmatrix(f, zero);
    setring RTPr;
    ideal F2 = fitting(PM, 2);

    "";
    "F2(f):";
    F2;

    "";
    "C{" + varstr(RTPr) + "}/F2(f):";
    kbase(std(F2));

    // ----- Compute C{X,Y,Z}/J(H1,H2) -----

    setring R;
    ideal H = Z-3X12,Y4-9*16*Z3;
    H = jacob(H);

    "";
    "J(H):";
    H;

    "";
    "C{X,Y,Z}/J(H):";
    kbase(std(H));



