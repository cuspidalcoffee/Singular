version="$Id: presmatrix.lib  2013-12-03 $";
category="Singularity Theory, Commutative Algebra";
info="
LIBRARY:  presmatrix.lib          Compute presentation matrix

AUTHORS:  Marcelo Escudeiro Hernandes,     mehernandes@uem.br
          Aldicio Jose Miranda,            aldicio@famat.ufu.br
          Guillermo Penafort-Sanchis,      guillermo.penafort@uv.es 
  
PROCEDURES:
  presmatrix(Pullf, ISource); compute presentation matrix";

 LIB "matrix.lib";
 LIB "rootsur.lib";
 LIB "ring.lib";
 LIB "homolog.lib";
 
//-------------------------------------------------------------------------------------------------
proc presmatrix(map Pullf, ideal ISource)
{
	option(noredefine);
 
	ring RS = basering;

	if (ord_test(basering) != -1)
		{ "// No local order ring! Get generators using local order"; }

	ideal IPullf = ideal(Pullf);
	string TName = nameof(preimage(Pullf));

	ring RT = preimage(Pullf);
	setring RS;
	int l = nvars(RS);
	int n = nvars(RT) - 1;
	int n2 = size(IPullf);

	if (n+1 != n2)
		{ ERROR("Target dimension must be equal the number of entries of given map!"); }

	ideal KB = IPullf[1..n], ISource;	// ideal by first "(n-1)-entries of f" + "ideal I"
	KB = kbase(std(KB));				// generators
	int K = size(KB);

	if(K == 0)
		{ ERROR("The number of generators must be greater than zero. Verify input!"); }

	matrix Gen[1][K];					// matrix of generators

	for(int r = 1; r <= K; r++)
		{ Gen[1, r] = KB[K - r + 1]; }    //just change the order of the generator}

	"//Generators = " + string(Gen);
 
	ring RG = char(RS), G(1..K), ds;		// auxiliar ring
	ring RXY = char(RT), (X(1..K),Y), ds;	// auxiliar target ring
	matrix M[K][K];						   	// auxiliar matrix
	matrix Pres = diag(Y, K);	       		// presentation matrix

	ring RSAux = char(RS), (x(1..l)), ds;	// internal auxiliary ring source
	ideal IPf = fetch(RS, IPullf);
	ideal I = fetch(RS, ISource); 

	map Pf = RXY, IPf;
	int done;						// indicates row done

	for (int rK = 1; rK <= K; rK++)
	{
		int d = 1;  
		done = 0;

		while (!done)
		{
						//    print("ROW "+string( rh)+" WITH DEGREE "+ string( d));
			
			setring RXY;
			matrix Pols = PolyGen(d);
			int np = size(Pols[1, 1]) + (K-1) * size(Pols[1, 2]) - 1;  // number of parameters
			poly D = Pols[1, 1];
			poly A = Pols[1, 2];

			ring RXYP1 = (char(RXY), a(1..np)), (X(1..n), Y), ds;	// target ring with parameters
			poly D = fetch(RXY, D);
			poly A = fetch(RXY, A);
			list ML = Row(rK, D, A, K);
			matrix M = ML[1];
			list ParList = ML[2];
			map mM = RG, M; 		// mM[i] = M[1, i], i = num.generators

			ring RSP1 = (char(RS), a(1..np)), x(1..l), dp;  		//source ring with the same parameters
			ideal IPf = fetch(RSAux, IPf);                          //copying IPf from RSAux to RSP1
			map Pf = RXYP1, IPf;
			ideal I = fetch(RSAux, I);
			I = std(I); 
	//		execute("matrix Gen=fetch("+RSName+",Gen)");      	        	
			matrix Gen = fetch(RS, Gen);
			poly p = (Pf(mM)[1]) * Gen[1, 1];

			/* We multiply the row matrix M by column matrix Gen, getting the generic polynomial in the source.
			* Next step is to reduce modulo ideal I */

			for(int c = 2; c <= K; c++) { p = p + Pf(mM)[c] * Gen[1, c]; }
			p = reduce(p, I);
					
			ideal J; 
			poly u = 1;
			
			for (c = 1; c <= l; c++)
				{ u = x(c) * u; } // needed to use "coef" below

			matrix C = coef(p, u);
			J = ideal(submat(C, 2, 1..ncols(C)));
			int sj = size(J);
					
			ring RP = char(RS), (a(1..np)), dp;	//ring of parameters
			ideal J = imap(RSP1, J);
			list L = Sols(J); 
			
			if ( L[1] == 0 )
				{ d++; }  // if the linear system of param. has no solution, then the degree increases
			else      
			{
				done = 1;  
				setring RXY;
						
				list L = imap(RP, L);   
				list ParList = imap(RXYP1, ParList);
				int szS = size(L[2]);
				int pr;
				
				//	replace the parameters by respective solutions
				for (c = 1; c <= szS; c++)
				{
					pr = L[2][c][1];
					Pres[rK, ParList[pr][2]] = Pres[rK, ParList[pr][2]] + L[2][c][2] * ParList[pr][1];
				}
			}
		}
	}

	setring RT;
    matrix PM[K][K] = fetch(RXY, Pres);

	string RK = TName + "^" + string(K);

	"";
	"// " + RK + " --- PM ---> " + RK + " ------> Ox ------> 0";
	"";
	"// Presentation matrix (PM):";
	print(PM);

	export(PM);

	"";
	"// To access the presentation matrix PM, type:";
	"//     setring " + TName + ";";
	"//     PM;";
}

static proc Sols(ideal nJ)
// return solutions of linear system of parameters
{ 
	list L;
	nJ = std(nJ);

    if(reduce(1, nJ) == 0)
	{
		L[1] = 0;
		L[2] = list();
	}
	else
	{
		L[1] = 1;
		L[2] = list();
		
		poly LM, Su, Ji;
		number LC;
		int s = size(nJ);
		int pos = 1;
		int i = 1;
        
		while (L[1] == 1 && i <= s)
		{
			LC = leadcoef(nJ[i]);

			if (LC != 0)
			{
				Ji = nJ[i];
				LM = leadmonom(Ji); 	
				Su = -Ji / LC + LM;

				for (int j = i + 1; j <= s; j++)
				{
				     nJ[j] = subst(nJ[j], LM, Su); 	
				}
			}

		  	i++;
	    }

		for(int i = s; i >= 1; i--)
		{
		    if (nJ[i] != 0)
			{
				Ji = nJ[i];
				LM = leadmonom(Ji);
			    
				while (univariate(Ji) == 0)
				{
					LM = leadmonom(Ji);
					nJ = subst(nJ, LM, 0);
					Ji = nJ[i];
				}

				LM = leadmonom(Ji);
				Su = -Ji / leadcoef(Ji) + LM;
              	L[2][pos] = list(univariate(Ji), Su);
 				
				pos++;
				nJ = subst(nJ, LM, Su);
			}
		}
	}
    
    return(L);
}

static proc Row(int rh, poly D, poly A, int h)
/* rh = rh line
 * D = diagonal polin
 * A = no diagonal polin.
 * h = order of present. matrix */
{
	matrix M[1][h];
	D = D-Y; 	 
	int sD = size(D);
	int sA = size(A); 
	list ParList;
	int c = 1;
	int i,j;

	// before (or left) the diagonal 
	for (j=1; j < rh; j++) 
    {   
		for(i=1; i <= sA; i++)
	    {                
			M[1, j] = A[i] * par(c) + M[1, j];
			ParList[c] = list(A[i], j);
			c++;
   	    }
	} 

	// in the diagonal
    for (i = 1; i <= sD; i++) 
    {
  		M[1, rh] = D[i] * par(c) + M[1, rh];
  		ParList[c] = list(D[i], rh);
  		c++;
    } 

    M[1, rh] = M[1, rh] + Y;

	// after (or right) the diagonal
    for (j = rh + 1; j <= h; j++)
    {
		for (i = 1; i <= sA; i++)
		{
	        M[1, j] = A[i] * par(c) + M[1, j];
	        ParList[c] = list(A[i], j);
	        c++;
		}			
    }
  
  list L;
  L[1] = M;
  L[2] = ParList;
  
  return(L);
}

static proc PolyGen(int d)
// Create polynomial with coefs = 1 and degree d
{ 
    poly D = sparsepoly(0, d, 0, 1);
    poly PY;

	for (int i=1; i<=d; i++)
	{
	    PY = PY + Y^i;
	}

    poly A = D - PY;
    matrix Pols[1][2] = D, A;
    
	return(Pols);
}                                                                          
///////////////////////////////////////////////////////////////////////////////////////////////////////////

//---------------- using presmatrix procedure to get presentation matrix-------------------------

//f:X ----> R^n, I=I(X) is the ideal that define the variety X, (X in O_{l}), X=Cohen-Macaulay (n-1)-dimensional
//choose the projection such that the quotient: O_{l}/<f_1,...f_n-1, I> has finite dimension.

//STEPS:

//1.  LIB "presmatrix.lib";
//2.  define the target ring "R";
//3.  define the source ring "r";
//4.  define: map f = R, f_1,...,f_n; 
//5.  define the ideal "I" in the source "r";

//Example: f(x,y)= (xy, x^3+y^4); I=-3x^3+4y^4;

//ring R=0,(X,Y),ds;
//ring r=0,(x,y),ds;
//map f=R,xy,x^3+y^4;
//ideal I=-3x^3+4y^4;                                                                                                                                     
//presmatrix(f, I);

//--------output---------------

//Generators = 1,x,x2,y,y2,y3,y4

//     PM
//R^h------>R^h------>Ox------>0;  h = 7, R = R

//Y,     0,     0,    0,     0,     0,    -283/27,
//0,     Y,     0,    0,     0,     -283/27X,0,   
//0,     0,     Y,    0,     -283/27X2,0,    0,   
//0,     0,     -283/256X,Y,     0,     0,    0,   
//0,     -283/256X2,0,    0,     Y,     0,    0,   
//-283/256X3,0,     0,    0,     0,     Y,    0,   
//0,     0,     0,    -283/256X3,0,     0,    Y    

//To access the presentation matrix PM, type:  setring RXYPr; PM; 